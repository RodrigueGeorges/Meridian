{
  "id": "stripe-terminal",
  "name": "Stripe Terminal (server-driven)",
  "version": "1.0.0",
  "kind": "acceptance_and_acquiring",
  "baseUrl": "https://api.stripe.com",
  "config": [
    { "key": "secretKey", "type": "string", "secret": true, "label": "Clé secrète Stripe" },
    { "key": "readerId", "type": "string", "label": "Identifiant du lecteur (tmr_…)" }
  ],
  "auth": { "header": "Authorization", "value": "Bearer {{config.secretKey}}" },
  "encoding": "form",
  "idempotency": { "header": "Idempotency-Key" },
  "pay": {
    "steps": [
      {
        "id": "create_intent",
        "method": "POST",
        "path": "/v1/payment_intents",
        "body": {
          "amount": "{{tx.amount}}",
          "currency": "{{tx.currencyLower}}",
          "payment_method_types": ["card_present"],
          "capture_method": "automatic",
          "metadata": { "meridian_ref": "{{tx.reference}}" }
        },
        "save": { "intentId": "id" }
      },
      {
        "id": "process",
        "method": "POST",
        "path": "/v1/terminal/readers/{{config.readerId}}/process_payment_intent",
        "body": { "payment_intent": "{{vars.intentId}}" },
        "retryErrors": ["terminal_reader_timeout"]
      }
    ]
  },
  "status": {
    "sources": {
      "intent": { "method": "GET", "path": "/v1/payment_intents/{{vars.intentId}}?expand[]=latest_charge" },
      "reader": { "method": "GET", "path": "/v1/terminal/readers/{{config.readerId}}" }
    },
    "rules": [
      { "when": [{ "path": "intent.status", "equals": "succeeded" }], "state": "authorized" },
      { "when": [{ "path": "intent.status", "equals": "requires_capture" }], "state": "authorized" },
      {
        "when": [
          { "path": "reader.action.status", "equals": "failed" },
          { "path": "reader.action.failure_code", "equals": "customer_canceled" }
        ],
        "state": "cancelled"
      },
      {
        "when": [{ "path": "reader.action.status", "equals": "failed" }],
        "state": "declined",
        "detailPath": "reader.action.failure_code"
      },
      { "when": [{ "path": "intent.status", "equals": "canceled" }], "state": "cancelled" }
    ]
  },
  "cancel": {
    "method": "POST",
    "path": "/v1/terminal/readers/{{config.readerId}}/cancel_action",
    "busyCodes": ["terminal_reader_busy"]
  },
  "cleanup": { "method": "POST", "path": "/v1/payment_intents/{{vars.intentId}}/cancel" },
  "refund": {
    "method": "POST",
    "path": "/v1/refunds",
    "body": { "payment_intent": "{{vars.intentId}}", "amount": "{{refund.amount}}" }
  },
  "health": { "method": "GET", "path": "/v1/terminal/readers/{{config.readerId}}" },
  "receipt": {
    "brand": "intent.latest_charge.payment_method_details.card_present.brand",
    "last4": "intent.latest_charge.payment_method_details.card_present.last4"
  },
  "capabilities": {
    "countries": ["FR", "BE", "NL", "DE", "ES", "IT", "AT", "IE", "PT", "LU"],
    "currencies": ["EUR"],
    "paymentMethods": { "*": ["visa", "mastercard", "amex"], "FR": ["cb"] },
    "partialRefund": true,
    "cancelDuringAuth": false,
    "languages": ["fr", "en", "de", "es", "it", "nl"],
    "compatProtocols": []
  }
}
