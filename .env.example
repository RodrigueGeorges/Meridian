# --- API Meridian ---
PORT=8080
# Sans DATABASE_URL : mode éphémère (journal en mémoire, ou fichier si JOURNAL_FILE est défini).
# En production le démarrage refuse l'absence de base ; contournement explicite : ALLOW_EPHEMERAL=true.
DATABASE_URL=postgres://meridian:meridian@localhost:5432/meridian
# Connexion via un pooler en mode transaction ? À éviter (verrous consultatifs de session) ; pour forcer :
#DATABASE_POOLED_OK=true
#ALLOW_EPHEMERAL=true
# Clé de signature HMAC du journal (≥ 16 caractères), conservée hors base.
# Rotation : JOURNAL_KEY_ID = identifiant courant, JOURNAL_KEYS_PREVIOUS = « kid=clé,kid=clé » retirées
# (voir docs/production-checklist.md et README → rotation des clés).
JOURNAL_KEY=change-me-journal-key-0123456789
#JOURNAL_KEY_ID=1
#JOURNAL_KEYS_PREVIOUS=1=ancienne-cle,kid2=plus-ancienne
# Clé maîtresse de chiffrement des secrets PSP (≥ 32 caractères).
# Rotation : MASTER_KEY_VERSION = version courante, MASTER_KEYS_PREVIOUS = « v=clé,v=clé » retirées,
# puis `pnpm rotate-secrets` pour rechiffrer les secrets en base.
MASTER_KEY=change-me-master-key-0123456789abcdef0123456789
#MASTER_KEY_VERSION=1
#MASTER_KEYS_PREVIOUS=1=ancienne-master-key-0123456789abcdef0123456
# Clé API de démarrage (organisation org_demo). Format mk_test_… ou mk_live_…
BOOTSTRAP_API_KEY=mk_test_demo0123456789abcdef
# Autorise une URL de PSP personnalisée (simulateur) pour les clés de test uniquement.
# Interdit dès qu'une clé live existe : le démarrage refuse ALLOW_TEST_BASE_URL + mk_live_…
ALLOW_TEST_BASE_URL=true
# Démo : crée un point de vente par pays de lancement, branché sur les simulateurs (clés de test seulement).
DEMO_SEED=true
SIM_STRIPE_URL=http://localhost:12111
SIM_SECOURS_URL=http://localhost:12112
# Webhooks sortants signés (optionnel). URL globale ; chaque organisation peut définir la sienne
# via PUT /v1/org/webhook (https + hôte public requis hors mode test).
WEBHOOK_URL=
WEBHOOK_SECRET=
# URL publique du site (ex. https://meridian.example). Sans elle, les URL absolues suivent l'en-tête Host.
PUBLIC_URL=
# Contact sécurité publié dans /.well-known/security.txt et durée de conservation des messages de contact.
#SECURITY_CONTACT=security@example.com
#CONTACT_RETENTION_DAYS=365
# Délai avant qu'un paiement sans issue soit signalé « bloqué » dans les logs (défaut moteur).
#STUCK_AFTER_MS=90000
# Jeton requis pour lire GET /v1/ops (métriques). Généré aléatoirement par tools/go-live.sh.
#METRICS_TOKEN=
# Derrière un proxy/TLS de plateforme (Fly.io, …) : fait confiance à X-Forwarded-For pour les limites de débit.
#TRUST_PROXY=true

# --- Test sandbox Stripe réelle (jamais de clé live) ---
STRIPE_KEY=sk_test_xxx
COUNTRY=FR

# --- Passerelles caisses existantes (réseau local du magasin uniquement) ---
BRIDGE_HOST=127.0.0.1
# Concert / Caisse-AP (France) : port 8888 ; n° de caisse (CA) → point de vente
CONCERT_PORT=8888
CONCERT_POS_MAP=01=pos_demo_FR
# ZVT (DE/AT/CH) : port 20007 ; un point de vente par port
ZVT_PORT=20007
ZVT_POS=pos_demo_DE

# Multi-instance (avec DATABASE_URL) : intervalle de reprise des paiements orphelins, en ms
SCAN_MS=3000

# Tuning charge : taille du pool PostgreSQL (défaut 10 — viser ~2× le nombre de cœurs par instance)
# et délai d'attente des paiements en cours à l'arrêt (défaut 20000 ms, doit rester < kill_timeout).
#DATABASE_POOL_MAX=20
#DRAIN_MS=20000

# IA autour du paiement (jamais dans le paiement) : lecture de relevés, conseiller, assistant de support.
# Sans clé, ces fonctions répondent 503 ; l'assistant de support rend alors les faits du journal sans reformulation.
# Fournisseur par défaut : Mistral AI, point d'accès européen (api.eu.mistral.ai).
MISTRAL_API_KEY=
# AI_PROVIDER=mistral                      # ou anthropic (avec ANTHROPIC_API_KEY)
# Modèle par usage (valeurs par défaut avec Mistral) :
# AI_MODEL_OCR=mistral-ocr-latest          # lecture des PDF et photos de relevés, y compris scannés
# AI_MODEL_STATEMENT=mistral-medium-latest # extraction des chiffres d'un relevé
# AI_MODEL_ADVISOR=mistral-small-latest    # description d'activité en langage naturel
# AI_MODEL_SUPPORT=mistral-small-latest    # explication d'un paiement
# AI_MODEL_MODULEGEN=mistral-medium-latest # brouillons de modules PSP (outil interne)
# AI_BASE_URL=https://api.eu.mistral.ai    # point d'accès (par défaut : européen)
# ANTHROPIC_API_KEY=                       # option : AI_PROVIDER=anthropic
